# 平台下发（本地模式创建跑分任务后获得）
BENCHMARK_BASE_URL=
BENCHMARK_TOKEN=
# 靶场 VPN 配置另外下发，需先连接

# LLM（白名单内任选，OpenAI 兼容）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
# 多模型分工（强烈建议配置）：hard 题全程、easy/medium 一轮未解（attempt≥1）的
# claude 会话与 retry 轮 advisor brief 都用该模型，其余用 LLM_MODEL。
# run 10282 复盘：未配置时 pro 全程只被调用 1 次，hard 题全靠 flash 单模型。
LLM_MODEL_HARD=deepseek-v4-pro
# hard 会话 effort（思考预算）：默认 max（run 10048 复盘 hard 20min 0 分=深度不够）；
# 置空关闭。easy/medium 不用（flash 秒解，省时省钱）。
# CLAUDE_HARD_EFFORT=max
# 托管沙箱网关改写后缀：Tsecbench 默认 .tsecbench.gw；换平台（如百度）按新平台规则配
# GATEWAY_SUFFIX=.tsecbench.gw

# 策略（可选）：6 小时冲刺默认 free，优先换取更多已解题数
HINT_POLICY=free
# stuck 策略下 hint 开放分钟数（默认 8）；claude 模式 retry 轮/断点重跑自动注入官方提示
# HINT_AFTER_MIN=8
# 并发题目数：写死平台上限 3（409 不降级，题轮转队尾等槽位；槽位空出立即补位）
MAX_CONCURRENT=3
# Agent 思考线并发：3 题 = 3 个主 claude 进程 + 断点重跑等辅助调用余量。
# 子 agent 在主进程内并行（Task 工具），不占此额度。
MAX_AGENT_CONCURRENT=6
GLOBAL_BUDGET_MIN=345
# 两轮赛制：ROUND=1 覆盖优先（全题过手留解法）；ROUND=2 收割（不设熔断，解开为终极目标）
# ROUND=2
# 第一轮（ROUND=1）熔断：覆盖优先快速过手，token/步数超限即放弃轮转留给第二轮。
# 第二轮不设熔断。
# ROUND1_MAX_STEPS=40
# ROUND1_TOKEN_BUDGET=200000

# 启动预侦察（默认开：每题先自动跑 nmap+HTTP 指纹再交给 LLM，省 3-5 轮往返）
# RECON_BOOT=1
# 解法库回写（默认开：解出/超时都会记录，供下一轮注入复现/续跑）
# RECORD_SOLUTIONS=1
# 上下文预算（估算 token；默认 90000，全中文长题调低防 LLM 400）
# CONTEXT_CHAR_BUDGET=90000
